@model Categoria
@{ ViewData["Title"] = "Excluir categoria"; }
<h1>Excluir categoria</h1>
<div class="alert alert-warning">Confirma a exclusão de <strong>@Model.Nome</strong>? Categorias com pratos vinculados não podem ser excluídas.</div>
<p>Pratos vinculados: <strong>@Model.Pratos.Count</strong></p>
<form asp-action="Excluir" asp-route-id="@Model.Id" method="post"><button class="btn btn-danger" type="submit" disabled="@(Model.Pratos.Count > 0)">Confirmar exclusão</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></form>
