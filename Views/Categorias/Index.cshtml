@model ListaPaginada<Categoria>
@{ ViewData["Title"] = "Categorias"; string ProximaDirecao(string campo) => Model.Ordenar == campo && Model.Direcao == "asc" ? "desc" : "asc"; }
<div class="d-flex justify-content-between gap-3 align-items-center mb-3"><h1 class="mb-0">Categorias</h1><a class="btn btn-primary" asp-action="Criar">+ Nova categoria</a></div>
<form method="get" asp-action="Index" class="row g-2 mb-3"><div class="col-sm-9"><label class="visually-hidden" for="busca">Buscar</label><input id="busca" name="busca" value="@Model.Busca" class="form-control" placeholder="Buscar categoria por nome" /></div><div class="col-sm-3 d-flex gap-2"><button class="btn btn-outline-primary flex-grow-1">Buscar</button><a class="btn btn-outline-secondary" asp-action="Index">Limpar</a></div></form>
<div class="table-responsive card shadow-sm"><table class="table table-hover align-middle mb-0"><thead><tr>
<th><a asp-action="Index" asp-route-busca="@Model.Busca" asp-route-ordenar="nome" asp-route-direcao="@ProximaDirecao("nome")">Nome ↕</a></th>
<th><a asp-action="Index" asp-route-busca="@Model.Busca" asp-route-ordenar="quantidade" asp-route-direcao="@ProximaDirecao("quantidade")">Qtd. pratos ↕</a></th><th>Ações</th></tr></thead><tbody>
@foreach (var item in Model.Itens) { <tr><td>@item.Nome</td><td>@item.Pratos.Count</td><td class="acoes"><a asp-action="Detalhes" asp-route-id="@item.Id">Detalhes</a><a asp-action="Editar" asp-route-id="@item.Id">Editar</a><a asp-action="Excluir" asp-route-id="@item.Id" class="text-danger">Excluir</a></td></tr> }
@if (Model.Itens.Count == 0) { <tr><td colspan="3" class="text-center py-4">Nenhuma categoria encontrada.</td></tr> }
</tbody></table></div>
<div class="d-flex justify-content-between align-items-center mt-3"><span class="small text-secondary">@Model.TotalItens resultado(s) • Página @Model.Pagina de @Model.TotalPaginas</span><nav aria-label="Paginação de categorias"><div class="btn-group"><a class="btn btn-outline-secondary @(Model.Pagina == 1 ? "disabled" : "")" asp-action="Index" asp-route-busca="@Model.Busca" asp-route-ordenar="@Model.Ordenar" asp-route-direcao="@Model.Direcao" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a><a class="btn btn-outline-secondary @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")" asp-action="Index" asp-route-busca="@Model.Busca" asp-route-ordenar="@Model.Ordenar" asp-route-direcao="@Model.Direcao" asp-route-pagina="@(Model.Pagina + 1)">Próxima</a></div></nav></div>
