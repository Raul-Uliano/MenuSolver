@model ListaPaginada<Prato>
@{ ViewData["Title"] = "Pratos"; string ProximaDirecao(string campo) => Model.Ordenar == campo && Model.Direcao == "asc" ? "desc" : "asc"; var nomes = (Dictionary<int,string>)ViewBag.NomesCategorias; }
<div class="d-flex justify-content-between gap-3 align-items-center mb-3"><h1 class="mb-0">Pratos</h1><a asp-action="Criar" class="btn btn-primary">+ Novo prato</a></div>
<form method="get" asp-action="Index" class="row g-2 mb-3"><div class="col-md-5"><label class="visually-hidden" for="busca">Nome do prato</label><input id="busca" name="busca" value="@Model.Busca" class="form-control" placeholder="Buscar prato pelo nome" /></div><div class="col-md-4"><label class="visually-hidden" for="categoriaId">Categoria</label><select id="categoriaId" name="categoriaId" asp-items="ViewBag.Categorias" class="form-select"><option value="">Todas as categorias</option></select></div><div class="col-md-3 d-flex gap-2"><button class="btn btn-outline-primary flex-grow-1">Filtrar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpar</a></div></form>
<div class="card shadow-sm table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Foto</th>
<th><a asp-action="Index" asp-route-busca="@Model.Busca" asp-route-categoriaId="@Model.CategoriaId" asp-route-ordenar="nome" asp-route-direcao="@ProximaDirecao("nome")">Nome ↕</a></th>
<th><a asp-action="Index" asp-route-busca="@Model.Busca" asp-route-categoriaId="@Model.CategoriaId" asp-route-ordenar="categoria" asp-route-direcao="@ProximaDirecao("categoria")">Categoria ↕</a></th>
<th><a asp-action="Index" asp-route-busca="@Model.Busca" asp-route-categoriaId="@Model.CategoriaId" asp-route-ordenar="preco" asp-route-direcao="@ProximaDirecao("preco")">Preço ↕</a></th><th>Ações</th></tr></thead><tbody>
@foreach (var item in Model.Itens) { <tr><td>@if (!string.IsNullOrEmpty(item.ImagemPath)) { <img class="miniatura" alt="Foto de @item.Nome" src="@item.ImagemPath" /> } else { <span class="text-secondary small">Sem foto</span> }</td><td>@item.Nome</td><td>@nomes.GetValueOrDefault(item.CategoriaId, "-")</td><td>@item.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td><td class="acoes"><a asp-action="Detalhes" asp-route-id="@item.Id">Detalhes</a><a asp-action="Editar" asp-route-id="@item.Id">Editar</a><a asp-action="Excluir" asp-route-id="@item.Id" class="text-danger">Excluir</a></td></tr> }
@if (Model.Itens.Count == 0) { <tr><td colspan="5" class="text-center py-4">Nenhum prato encontrado.</td></tr> }
</tbody></table></div>
<div class="d-flex justify-content-between align-items-center mt-3"><span class="small text-secondary">@Model.TotalItens resultado(s) • Página @Model.Pagina de @Model.TotalPaginas</span><nav aria-label="Paginação de pratos"><div class="btn-group"><a class="btn btn-outline-secondary @(Model.Pagina == 1 ? "disabled" : "")" asp-action="Index" asp-route-busca="@Model.Busca" asp-route-categoriaId="@Model.CategoriaId" asp-route-ordenar="@Model.Ordenar" asp-route-direcao="@Model.Direcao" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a><a class="btn btn-outline-secondary @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")" asp-action="Index" asp-route-busca="@Model.Busca" asp-route-categoriaId="@Model.CategoriaId" asp-route-ordenar="@Model.Ordenar" asp-route-direcao="@Model.Direcao" asp-route-pagina="@(Model.Pagina + 1)">Próxima</a></div></nav></div>
