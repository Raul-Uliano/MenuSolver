@model PratoFormulario
@{ ViewData["Title"] = "Editar prato"; }
<h1>Editar prato</h1>
<form asp-action="Editar" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="form-card"><input asp-for="Id" type="hidden" />
    
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Descricao" class="form-label"></label><textarea asp-for="Descricao" class="form-control" rows="3"></textarea><span asp-validation-for="Descricao" class="text-danger"></span></div>
    <div class="row"><div class="col-sm-6 mb-3"><label asp-for="Preco" class="form-label"></label><input asp-for="Preco" class="form-control" type="number" min="0.01" max="9999.99" step="0.01" placeholder="39,90" /><span asp-validation-for="Preco" class="text-danger"></span></div>
    <div class="col-sm-6 mb-3"><label asp-for="CategoriaId" class="form-label"></label><select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select"><option value="0">Selecione uma categoria</option></select><span asp-validation-for="CategoriaId" class="text-danger"></span></div></div>
    <div class="mb-3"><label asp-for="Imagem" class="form-label"></label><input asp-for="Imagem" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" /><div class="form-text">JPG, PNG ou WEBP, até 2 MB.</div><span asp-validation-for="Imagem" class="text-danger"></span></div>
    @if (!string.IsNullOrEmpty(Model.ImagemAtual)) { <div class="mb-3"><p class="small text-secondary">Foto atual:</p><img class="foto-preview" src="@Model.ImagemAtual" alt="Foto atual do prato" /></div> }
    <button type="submit" class="btn btn-primary">Salvar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
