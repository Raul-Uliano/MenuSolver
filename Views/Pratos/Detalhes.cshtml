@model Prato
@{ ViewData["Title"] = "Detalhes do prato"; }
<h1>@Model.Nome</h1>
<div class="card shadow-sm"><div class="card-body"><div class="row g-3"><div class="col-md-4">@if (!string.IsNullOrEmpty(Model.ImagemPath)) { <img src="@Model.ImagemPath" alt="Foto de @Model.Nome" class="img-fluid rounded" /> } else { <div class="imagem-ausente">Sem foto</div> }</div><div class="col-md-8"><p>@Model.Descricao</p><p><strong>Categoria:</strong> @ViewBag.NomeCategoria</p><p><strong>Preço:</strong> @Model.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</p><p class="text-secondary small">Cadastrado em: @Model.CriadoEm.ToString("dd/MM/yyyy HH:mm")</p></div></div></div></div>
<div class="mt-3"><a class="btn btn-primary" asp-action="Editar" asp-route-id="@Model.Id">Editar</a><a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
